{
  "name": "g-bot-astra",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"*.{json,ts,mjs}\"",
    "test:prepare-browser": "node scripts/prepare-browser.mjs",
    "desktop:compile": "node scripts/build-desktop.mjs",
    "desktop:build": "npm run build && npm run desktop:compile",
    "desktop:start": "electron .",
    "desktop:package": "npm run desktop:build && electron-builder --dir",
    "desktop:dist": "npm run desktop:build && electron-builder",
    "test:desktop": "node --import tsx --test tests/desktop/*.test.ts",
    "desktop:demo": "electron . --demo",
    "test:electron": "node scripts/smoke-electron.mjs",
    "test:production": "node --import tsx --test tests/production/*.test.ts",
    "lint": "prettier --check \"src/production/**/*.{ts,tsx}\" \"desktop/runtime/{identity,encrypted,snapshots,update-integrity}.ts\"",
    "security:scan": "node scripts/security-scan.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@sentry/node": "^11.0.0",
    "@supabase/supabase-js": "^2.117.1",
    "@tailwindcss/postcss": "4.2.1",
    "@tanstack/react-query": "^5.90.0",
    "ajv": "^8.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.23.0",
    "mammoth": "^1.12.3",
    "next": "15.5.25",
    "pdfjs-dist": "^6.3.289",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.62.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "stripe": "^22.6.2",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "4.2.1",
    "zod": "^4.1.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@sparticuz/chromium": "^153.0.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^44.4.4",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.8",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "main": "desktop-dist/main.cjs",
  "description": "Local-first AI business assistant",
  "author": "G-Bot contributors",
  "build": {
    "appId": "com.gbot.astra",
    "productName": "G-Bot",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop-dist/**",
      ".next/**",
      "public/**",
      "package.json",
      "next.config.mjs",
      "!node_modules/@sparticuz/**"
    ],
    "asarUnpack": [
      ".next/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "verifyUpdateCodeSignature": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "category": "public.app-category.productivity",
      "minimumSystemVersion": "13.0",
      "notarize": true
    },
    "linux": {
      "target": [
        "dir"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "knitfury",
        "repo": "G-Bot-Astra",
        "releaseType": "draft"
      }
    ]
  },
  "overrides": {
    "next": {
      "postcss": "8.5.28"
    },
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
