# Public configuration. Use distinct values in each environment. Never put service keys in NEXT_PUBLIC_*.
NEXT_PUBLIC_GBOT_ENVIRONMENT=development
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-DEVELOPMENT-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
NEXT_PUBLIC_ACCOUNT_ORIGIN=http://localhost:3000
# Trusted hosting server only. NEVER package in Electron or commit actual values.
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_MONTHLY_PRICE=
STRIPE_STARTER_ANNUAL_PRICE=
STRIPE_BUSINESS_MONTHLY_PRICE=
STRIPE_BUSINESS_ANNUAL_PRICE=
STRIPE_PORTAL_CONFIGURATION=
GBOT_LICENSE_KEY_ID=development-1
GBOT_LICENSE_PRIVATE_KEY=
# Desktop-only public values; PEM keys are a JSON map keyed by key ID.
GBOT_CONTROL_PLANE_URL=https://account.vidinex.ee
GBOT_LICENSE_PUBLIC_KEYS={}
GBOT_CATALOG_PUBLIC_KEYS={}
# Optional. Sanitized diagnostics are opt-in.
GBOT_SENTRY_DSN=
